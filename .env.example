# ---------- Postgres ----------
POSTGRES_USER=dealflow
POSTGRES_PASSWORD=dealflow
POSTGRES_DB=dealflow
DATABASE_URL=postgresql://dealflow:dealflow@postgres:5432/dealflow?schema=public

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- MinIO (S3-compatible) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=dealflow

# ---------- API ----------
API_PORT=3000
NODE_ENV=development

# ---------- Mail (Mailhog) ----------
SMTP_HOST=mailhog
SMTP_PORT=1025

# ---------- JWT ----------
JWT_SECRET=dealflow360-super-secret-key-for-dev-only

# ---------- Realtime / Portal ----------
SOCKET_CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174
PORTAL_URL=http://localhost

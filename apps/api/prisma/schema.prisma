generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DealflowMeta {
  key   String @id
  value String

  @@map("_dealflow_meta")
}

model Organization {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  status              String   @default("active") // "active" | "suspended"
  logoUrl             String?  @map("logo_url")
  address             String?
  description         String?
  contactEmail        String?  @map("contact_email")
  contactPhone        String?  @map("contact_phone")
  website             String?
  currency            String   @default("USD")
  timezone            String   @default("UTC")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  categories          ProductCategory[]
  products            Product[]
  customerTiers       CustomerTier[]
  priceListItems      PriceListItem[]
  discountCeilings    DiscountCeiling[]
  approvalChainConfig ApprovalChainConfig?
  orderLines          OrderLine[]
  users               User[]
  invites             OrganizationInvite[]
  customers           Customer[]
  quotations          Quotation[]
  quotationLines      QuotationLine[]
  affinities          ProductAffinity[]
  approvalRequests    ApprovalRequest[]
  auditLogs           AuditLog[]
  negotiationComments NegotiationComment[]
  changeRequests      ChangeRequest[]
  counterProposals    CounterProposal[]
  warehouses          Warehouse[]
  stockLevels         StockLevel[]
  shippingRuleConfig  ShippingRuleConfig?
  fulfillmentPlans    FulfillmentPlan[]
  fulfillmentLines    FulfillmentLine[]
  backorderItems      BackorderItem[]
  consolidationPrompts ConsolidationPrompt[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String?
  role           String   // "super_admin" | "org_admin" | "rep" | "manager" | "finance" | "ops"
  status         String   @default("active") // "active" | "suspended" | "pending"
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotations   Quotation[]
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequestedBy")
  actionedApprovals  ApprovalRequest[] @relation("ApprovalActionedBy")
  negotiationComments   NegotiationComment[] @relation("NegotiationAuthor")
  resolvedChangeRequests ChangeRequest[]     @relation("ChangeRequestResolvedBy")
  decidedCounterProposals CounterProposal[]  @relation("CounterProposalDecidedBy")
  consolidatedPrompts   ConsolidationPrompt[] @relation("ConsolidatedBy")

  @@index([organizationId])
  @@map("users")
}

model OrganizationInvite {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  email          String
  role           String    @default("org_admin")
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("organization_invites")
}

model ProductCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String   // "hardware", "services", "subscriptions", or custom
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products         Product[]
  discountCeilings DiscountCeiling[]
  quotationLines   QuotationLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("product_categories")
}

model CustomerTier {
  id                     String   @id @default(uuid())
  organizationId         String   @map("organization_id")
  name                   String   // "Bronze", "Silver", "Gold", etc.
  code                   String   // "bronze", "silver", "gold", etc.
  description            String?
  defaultDiscountPercent Decimal  @default(0.00) @map("default_discount_percent") @db.Decimal(5, 2)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceListItems   PriceListItem[]
  discountCeilings DiscountCeiling[]
  customers        Customer[]
  quotations       Quotation[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("customer_tiers")
}

model Product {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  categoryId       String?  @map("category_id")
  name             String
  sku              String
  description      String?
  price            Decimal  @db.Decimal(12, 2)
  costPrice        Decimal? @map("cost_price") @db.Decimal(12, 2)
  billingFrequency String   @default("one_time") @map("billing_frequency") // "one_time" | "monthly" | "quarterly" | "annual"
  status           String   @default("active") // "active" | "archived"
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: SetNull)
  orderLines     OrderLine[]
  priceListItems PriceListItem[]
  quotationLines QuotationLine[]
  stockLevels    StockLevel[]
  primaryAffinities      ProductAffinity[] @relation("PrimaryAffinity")
  recommendedAffinities  ProductAffinity[] @relation("RecommendedAffinity")
  backorderItems         BackorderItem[]
  consolidationPrompts   ConsolidationPrompt[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@map("products")
}

model PriceListItem {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  tierId         String   @map("tier_id")
  productId      String   @map("product_id")
  customPrice    Decimal  @map("custom_price") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier         CustomerTier @relation(fields: [organizationId, tierId], references: [organizationId, id], onDelete: Cascade)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, tierId, productId])
  @@index([organizationId])
  @@index([organizationId, tierId])
  @@index([organizationId, productId])
  @@map("price_list_items")
}

model OrderLine {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  productId      String   @map("product_id")
  quantity       Int      @default(1)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, productId])
  @@map("order_lines")
}

model DiscountCeiling {
  id                 String          @id @default(uuid())
  organizationId     String          @map("organization_id")
  tierId             String          @map("tier_id")
  categoryId         String          @map("category_id")
  maxDiscountPercent Decimal         @default(0.00) @map("max_discount_percent") @db.Decimal(5, 2)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier               CustomerTier    @relation(fields: [organizationId, tierId], references: [organizationId, id], onDelete: Cascade)
  category           ProductCategory @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, tierId, categoryId])
  @@index([organizationId])
  @@index([organizationId, tierId])
  @@index([organizationId, categoryId])
  @@map("discount_ceilings")
}

model ApprovalChainConfig {
  id                         String       @id @default(uuid())
  organizationId             String       @unique @map("organization_id")
  managerThresholdPercent     Decimal      @default(0.00) @map("manager_threshold_percent") @db.Decimal(5, 2)
  financeThresholdPercent     Decimal      @default(15.00) @map("finance_threshold_percent") @db.Decimal(5, 2)
  requireFinanceAboveThreshold Boolean     @default(true) @map("require_finance_above_threshold")
  autoApproveWithinCeilings  Boolean      @default(true) @map("auto_approve_within_ceilings")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("approval_chain_configs")
}

model Customer {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  tierId         String   @map("tier_id")
  name           String
  email          String
  company        String?
  phone          String?
  address        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier         CustomerTier @relation(fields: [organizationId, tierId], references: [organizationId, id], onDelete: Restrict)
  quotations   Quotation[]

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, tierId])
  @@map("customers")
}

model Quotation {
  id                   String          @id @default(uuid())
  organizationId       String          @map("organization_id")
  quotationNumber      String          @map("quotation_number")
  customerId           String          @map("customer_id")
  tierId               String          @map("tier_id")
  repId                String?         @map("rep_id")
  status               String          @default("draft") // "draft" | "pending_approval" | "approved" | "sent" | "negotiating" | "confirmed" | "rejected"
  orderDiscountPercent Decimal         @default(0.00) @map("order_discount_percent") @db.Decimal(5, 2)
  orderDiscountAmount  Decimal         @default(0.00) @map("order_discount_amount") @db.Decimal(12, 2)
  subtotal             Decimal         @default(0.00) @db.Decimal(12, 2)
  totalDiscount        Decimal         @default(0.00) @map("total_discount") @db.Decimal(12, 2)
  totalAmount          Decimal         @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  totalCost            Decimal         @default(0.00) @map("total_cost") @db.Decimal(12, 2)
  totalMargin          Decimal         @default(0.00) @map("total_margin") @db.Decimal(12, 2)
  totalMarginPercent   Decimal         @default(0.00) @map("total_margin_percent") @db.Decimal(5, 2)
  oneTimeTotal         Decimal         @default(0.00) @map("one_time_total") @db.Decimal(12, 2)
  recurringMonthlyTotal Decimal        @default(0.00) @map("recurring_monthly_total") @db.Decimal(12, 2)
  recurringAnnualTotal  Decimal        @default(0.00) @map("recurring_annual_total") @db.Decimal(12, 2)
  riskScore            Decimal         @default(0.00) @map("risk_score") @db.Decimal(5, 2)
  riskLevel            String          @default("low") @map("risk_level") // "low" | "medium" | "high"
  approvalRouting      String          @default("none") @map("approval_routing") // "none" | "manager" | "manager_finance"
  riskDetails          Json?           @map("risk_details")
  notes                String?
  validUntil           DateTime?       @map("valid_until")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  tier         CustomerTier    @relation(fields: [organizationId, tierId], references: [organizationId, id], onDelete: Restrict)
  rep          User?           @relation(fields: [repId], references: [id], onDelete: SetNull)
  lines        QuotationLine[]
  approvalRequests ApprovalRequest[]
  negotiationComments NegotiationComment[]
  changeRequests      ChangeRequest[]
  counterProposals    CounterProposal[]
  fulfillmentPlans    FulfillmentPlan[]
  backorderItems      BackorderItem[]
  consolidationPrompts ConsolidationPrompt[]

  @@unique([organizationId, id])
  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@index([organizationId, riskLevel])
  @@map("quotations")
}

model QuotationLine {
  id                   String           @id @default(uuid())
  organizationId       String           @map("organization_id")
  quotationId          String           @map("quotation_id")
  productId            String           @map("product_id")
  categoryId           String?          @map("category_id")
  quantity             Int              @default(1)
  unitPrice            Decimal          @map("unit_price") @db.Decimal(12, 2)
  costPrice            Decimal          @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  lineDiscountPercent  Decimal          @default(0.00) @map("line_discount_percent") @db.Decimal(5, 2)
  lineDiscountAmount   Decimal          @default(0.00) @map("line_discount_amount") @db.Decimal(12, 2)
  subtotal             Decimal          @default(0.00) @db.Decimal(12, 2)
  total                Decimal          @default(0.00) @db.Decimal(12, 2)
  marginAmount         Decimal          @default(0.00) @map("margin_amount") @db.Decimal(12, 2)
  marginPercent        Decimal          @default(0.00) @map("margin_percent") @db.Decimal(5, 2)
  appliedCeilingPercent Decimal         @default(0.00) @map("applied_ceiling_percent") @db.Decimal(5, 2)
  riskDeltaPercent     Decimal          @default(0.00) @map("risk_delta_percent") @db.Decimal(5, 2)
  isOverCeiling        Boolean          @default(false) @map("is_over_ceiling")
  billingFrequency     String           @default("one_time") @map("billing_frequency") // "one_time" | "monthly" | "quarterly" | "annual"
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation        @relation(fields: [organizationId, quotationId], references: [organizationId, id], onDelete: Cascade)
  product      Product          @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  category     ProductCategory? @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: SetNull)
  negotiationComments NegotiationComment[]
  changeRequests      ChangeRequest[]
  counterProposals    CounterProposal[]
  fulfillmentLines    FulfillmentLine[]
  backorderItems      BackorderItem[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, quotationId])
  @@index([organizationId, productId])
  @@map("quotation_lines")
}

model ProductAffinity {
  id                    String   @id @default(uuid())
  organizationId        String   @map("organization_id")
  productId             String   @map("product_id")
  recommendedProductId  String   @map("recommended_product_id")
  coPurchaseCount       Int      @default(1) @map("co_purchase_count")
  affinityScore         Decimal  @default(0.0000) @map("affinity_score") @db.Decimal(5, 4)
  recommendationReason  String?  @map("recommendation_reason")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product               Product      @relation("PrimaryAffinity", fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  recommendedProduct    Product      @relation("RecommendedAffinity", fields: [organizationId, recommendedProductId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, productId, recommendedProductId])
  @@index([organizationId])
  @@index([organizationId, productId])
  @@index([organizationId, recommendedProductId])
  @@map("product_affinities")
}

model ApprovalRequest {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  quotationId    String    @map("quotation_id")
  stage          String    // "manager" | "finance"
  status         String    @default("pending") // "pending" | "approved" | "rejected" | "escalated" | "superseded"
  assignedRole   String    @map("assigned_role") // "manager" | "finance"
  requestedById  String?   @map("requested_by_id")
  actionedById   String?   @map("actioned_by_id")
  reason         String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  actionedAt     DateTime? @map("actioned_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation      Quotation    @relation(fields: [organizationId, quotationId], references: [organizationId, id], onDelete: Cascade)
  requestedBy    User?        @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  actionedBy     User?        @relation("ApprovalActionedBy", fields: [actionedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, quotationId])
  @@index([organizationId, status])
  @@index([organizationId, stage, status])
  @@map("approval_requests")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  entityType     String   @map("entity_type") // "quotation" | "rulebook" | "user" | "organization"
  entityId       String   @map("entity_id")
  userId         String?  @map("user_id")
  userEmail      String?  @map("user_email")
  userRole       String?  @map("user_role")
  action         String   // "created" | "updated" | "deleted" | "submitted_for_approval" | "manager_approved" | "finance_escalated" | "finance_approved" | "rejected" | "edited" | "auto_approved" | "sent_to_customer" | "customer_commented" | "change_requested" | "counter_proposed" | "counter_accepted" | "counter_declined" | "change_request_accepted" | "change_request_declined" | "customer_confirmed" | "reentered_approval" | "deal_reopened" | "fulfillment_accepted" | "backorder_consolidated"
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ==================== PHASE 14 - NEGOTIATION & RE-APPROVAL ====================

model NegotiationComment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  quotationId    String   @map("quotation_id")
  lineId         String?  @map("line_id")
  authorType     String   @default("customer") @map("author_type") // "customer" | "internal"
  authorId       String?  @map("author_id")
  authorName     String   @map("author_name")
  authorEmail    String?  @map("author_email")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation      @relation(fields: [organizationId, quotationId], references: [organizationId, id], onDelete: Cascade)
  line         QuotationLine? @relation(fields: [organizationId, lineId], references: [organizationId, id], onDelete: Cascade)
  author       User?          @relation("NegotiationAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, quotationId, createdAt])
  @@index([organizationId, lineId])
  @@map("negotiation_comments")
}

model ChangeRequest {
  id                      String    @id @default(uuid())
  organizationId          String    @map("organization_id")
  quotationId             String    @map("quotation_id")
  lineId                  String?   @map("line_id")
  requestType             String    @map("request_type") // "quantity_change" | "remove_line" | "discount_change" | "other"
  proposedQuantity        Int?      @map("proposed_quantity")
  proposedDiscountPercent Decimal?  @map("proposed_discount_percent") @db.Decimal(5, 2)
  note                    String?
  status                  String    @default("open") @map("status") // "open" | "accepted" | "declined" | "applied"
  requestedByType         String    @default("customer") @map("requested_by_type")
  requestedByName         String    @map("requested_by_name")
  requestedByEmail        String?   @map("requested_by_email")
  resolvedById            String?   @map("resolved_by_id")
  resolvedAt              DateTime? @map("resolved_at")
  resolutionNote          String?   @map("resolution_note")
  createdAt               DateTime  @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation      @relation(fields: [organizationId, quotationId], references: [organizationId, id], onDelete: Cascade)
  line         QuotationLine? @relation(fields: [organizationId, lineId], references: [organizationId, id], onDelete: Cascade)
  resolvedBy   User?          @relation("ChangeRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, quotationId, status])
  @@index([organizationId, lineId])
  @@map("change_requests")
}

model CounterProposal {
  id                      String    @id @default(uuid())
  organizationId          String    @map("organization_id")
  quotationId             String    @map("quotation_id")
  lineId                  String?   @map("line_id") // null = order-level counter-discount
  proposedDiscountPercent Decimal   @map("proposed_discount_percent") @db.Decimal(5, 2)
  note                    String?
  status                  String    @default("open") @map("status") // "open" | "accepted" | "declined" | "superseded"
  proposedByType          String    @default("customer") @map("proposed_by_type")
  proposedByName          String    @map("proposed_by_name")
  proposedByEmail         String?   @map("proposed_by_email")
  decidedById             String?   @map("decided_by_id")
  decidedAt               DateTime? @map("decided_at")
  decisionNote            String?   @map("decision_note")
  createdAt               DateTime  @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation      @relation(fields: [organizationId, quotationId], references: [organizationId, id], onDelete: Cascade)
  line         QuotationLine? @relation(fields: [organizationId, lineId], references: [organizationId, id], onDelete: Cascade)
  decidedBy    User?          @relation("CounterProposalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, quotationId, status])
  @@index([organizationId, lineId])
  @@map("counter_proposals")
}

// ==================== PHASE 15 - WAREHOUSES & INVENTORY ====================

model Warehouse {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String // e.g. "WH-CENTRAL"
  address        String?
  city           String?
  isDefault      Boolean  @default(false) @map("is_default")
  status         String   @default("active") // "active" | "inactive"
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockLevels  StockLevel[]
  fulfillmentLines FulfillmentLine[]
  consolidationPrompts ConsolidationPrompt[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

model StockLevel {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  warehouseId    String   @map("warehouse_id")
  productId      String   @map("product_id")
  quantity       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Cascade)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, warehouseId, productId])
  @@index([organizationId])
  @@index([organizationId, productId])
  @@map("stock_levels")
}

model ShippingRuleConfig {
  id                       String   @id @default(uuid())
  organizationId           String   @unique @map("organization_id")
  allowSplitShipments      Boolean  @default(true) @map("allow_split_shipments")
  chargeForSplitShipments  Boolean  @default(false) @map("charge_for_split_shipments")
  deliveryExtensionDays    Int      @default(3) @map("delivery_extension_days")
  notes                    String?
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("shipping_rule_configs")
}

// ==================== PHASE 16 - FULFILLMENT SPLIT PROPOSAL ====================

model FulfillmentPlan {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  quotationId          String    @map("quotation_id")
  status               String    @default("proposed") @map("status") // "proposed" | "accepted"
  shipmentCount        Int       @default(0) @map("shipment_count")
  deliveryExtendedDays Int       @default(0) @map("delivery_extended_days")
  extraChargeNote      String?   @map("extra_charge_note")
  isOverridden         Boolean   @default(false) @map("is_overridden")
  overriddenById       String?   @map("overridden_by_id")
  overriddenAt         DateTime? @map("overridden_at")
  acceptedById         String?   @map("accepted_by_id")
  acceptedAt           DateTime? @map("accepted_at")
  proposedAt           DateTime  @default(now()) @map("proposed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation        @relation(fields: [organizationId, quotationId], references: [organizationId, id], onDelete: Cascade)
  lines        FulfillmentLine[]
  backorderItems BackorderItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, quotationId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("fulfillment_plans")
}

model FulfillmentLine {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  planId          String   @map("plan_id")
  quotationLineId String   @map("quotation_line_id")
  productId       String   @map("product_id")
  warehouseId     String   @map("warehouse_id")
  quantity        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan          FulfillmentPlan @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Cascade)
  quotationLine QuotationLine   @relation(fields: [organizationId, quotationLineId], references: [organizationId, id], onDelete: Cascade)
  warehouse     Warehouse       @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, planId, quotationLineId, warehouseId])
  @@index([organizationId])
  @@index([organizationId, planId])
  @@map("fulfillment_lines")
}

// ==================== PHASE 17 - BACKORDERS & AUTO-CONSOLIDATION ====================

model BackorderItem {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  quotationId     String    @map("quotation_id")
  quotationLineId String    @map("quotation_line_id")
  productId       String    @map("product_id")
  planId          String    @map("plan_id")
  quantity        Int
  fulfilledQty    Int       @default(0) @map("fulfilled_qty")
  status          String    @default("pending") @map("status") // "pending" | "partially_consolidated" | "consolidated" | "cancelled"
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation     Quotation       @relation(fields: [organizationId, quotationId], references: [organizationId, id], onDelete: Cascade)
  quotationLine QuotationLine   @relation(fields: [organizationId, quotationLineId], references: [organizationId, id], onDelete: Cascade)
  product       Product         @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  plan          FulfillmentPlan @relation(fields: [organizationId, planId], references: [organizationId, id], onDelete: Cascade)
  prompts       ConsolidationPrompt[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, productId, status])
  @@index([organizationId, quotationId])
  @@map("backorder_items")
}

model ConsolidationPrompt {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  quotationId      String    @map("quotation_id")
  backorderItemId  String    @map("backorder_item_id")
  warehouseId      String    @map("warehouse_id")
  productId        String    @map("product_id")
  suggestedQty     Int       @map("suggested_qty")
  status           String    @default("pending") @map("status") // "pending" | "consolidated" | "dismissed"
  consolidatedAt   DateTime? @map("consolidated_at")
  consolidatedById String?   @map("consolidated_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation      Quotation      @relation(fields: [organizationId, quotationId], references: [organizationId, id], onDelete: Cascade)
  backorderItem  BackorderItem  @relation(fields: [organizationId, backorderItemId], references: [organizationId, id], onDelete: Cascade)
  warehouse      Warehouse      @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product        Product        @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  consolidatedBy User?          @relation("ConsolidatedBy", fields: [consolidatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, quotationId])
  @@map("consolidation_prompts")
}

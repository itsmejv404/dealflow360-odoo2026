generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DealflowMeta {
  key   String @id
  value String

  @@map("_dealflow_meta")
}

model Organization {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  status              String   @default("active") // "active" | "suspended"
  logoUrl             String?  @map("logo_url")
  address             String?
  description         String?
  contactEmail        String?  @map("contact_email")
  contactPhone        String?  @map("contact_phone")
  website             String?
  currency            String   @default("USD")
  timezone            String   @default("UTC")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  categories          ProductCategory[]
  products            Product[]
  customerTiers       CustomerTier[]
  priceListItems      PriceListItem[]
  discountCeilings    DiscountCeiling[]
  approvalChainConfig ApprovalChainConfig?
  orderLines          OrderLine[]
  users               User[]
  invites             OrganizationInvite[]
  customers           Customer[]
  quotations          Quotation[]
  quotationLines      QuotationLine[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String?
  role           String   // "super_admin" | "org_admin" | "rep" | "manager" | "finance" | "ops"
  status         String   @default("active") // "active" | "suspended" | "pending"
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotations   Quotation[]

  @@index([organizationId])
  @@map("users")
}

model OrganizationInvite {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  email          String
  role           String    @default("org_admin")
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("organization_invites")
}

model ProductCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String   // "hardware", "services", "subscriptions", or custom
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products         Product[]
  discountCeilings DiscountCeiling[]
  quotationLines   QuotationLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("product_categories")
}

model CustomerTier {
  id                     String   @id @default(uuid())
  organizationId         String   @map("organization_id")
  name                   String   // "Bronze", "Silver", "Gold", etc.
  code                   String   // "bronze", "silver", "gold", etc.
  description            String?
  defaultDiscountPercent Decimal  @default(0.00) @map("default_discount_percent") @db.Decimal(5, 2)
  rank                   Int      @default(1)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceListItems   PriceListItem[]
  discountCeilings DiscountCeiling[]
  customers        Customer[]
  quotations       Quotation[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("customer_tiers")
}

model Product {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  categoryId       String?  @map("category_id")
  name             String
  sku              String
  description      String?
  price            Decimal  @db.Decimal(12, 2)
  costPrice        Decimal? @map("cost_price") @db.Decimal(12, 2)
  billingFrequency String   @default("one_time") @map("billing_frequency") // "one_time" | "monthly" | "quarterly" | "annual"
  status           String   @default("active") // "active" | "archived"
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: SetNull)
  orderLines     OrderLine[]
  priceListItems PriceListItem[]
  quotationLines QuotationLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@map("products")
}

model PriceListItem {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  tierId         String   @map("tier_id")
  productId      String   @map("product_id")
  customPrice    Decimal  @map("custom_price") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier         CustomerTier @relation(fields: [organizationId, tierId], references: [organizationId, id], onDelete: Cascade)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, tierId, productId])
  @@index([organizationId])
  @@index([organizationId, tierId])
  @@index([organizationId, productId])
  @@map("price_list_items")
}

model OrderLine {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  productId      String   @map("product_id")
  quantity       Int      @default(1)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, productId])
  @@map("order_lines")
}

model DiscountCeiling {
  id                 String          @id @default(uuid())
  organizationId     String          @map("organization_id")
  tierId             String          @map("tier_id")
  categoryId         String          @map("category_id")
  maxDiscountPercent Decimal         @default(0.00) @map("max_discount_percent") @db.Decimal(5, 2)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier               CustomerTier    @relation(fields: [organizationId, tierId], references: [organizationId, id], onDelete: Cascade)
  category           ProductCategory @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, tierId, categoryId])
  @@index([organizationId])
  @@index([organizationId, tierId])
  @@index([organizationId, categoryId])
  @@map("discount_ceilings")
}

model ApprovalChainConfig {
  id                         String       @id @default(uuid())
  organizationId             String       @unique @map("organization_id")
  managerThresholdPercent     Decimal      @default(0.00) @map("manager_threshold_percent") @db.Decimal(5, 2)
  financeThresholdPercent     Decimal      @default(15.00) @map("finance_threshold_percent") @db.Decimal(5, 2)
  requireFinanceAboveThreshold Boolean     @default(true) @map("require_finance_above_threshold")
  autoApproveWithinCeilings  Boolean      @default(true) @map("auto_approve_within_ceilings")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("approval_chain_configs")
}

model Customer {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  tierId         String   @map("tier_id")
  name           String
  email          String
  company        String?
  phone          String?
  address        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier         CustomerTier @relation(fields: [organizationId, tierId], references: [organizationId, id], onDelete: Restrict)
  quotations   Quotation[]

  @@unique([organizationId, id])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, tierId])
  @@map("customers")
}

model Quotation {
  id                   String          @id @default(uuid())
  organizationId       String          @map("organization_id")
  quotationNumber      String          @map("quotation_number")
  customerId           String          @map("customer_id")
  tierId               String          @map("tier_id")
  repId                String?         @map("rep_id")
  status               String          @default("draft") // "draft" | "pending_approval" | "approved" | "sent" | "confirmed" | "rejected"
  orderDiscountPercent Decimal         @default(0.00) @map("order_discount_percent") @db.Decimal(5, 2)
  orderDiscountAmount  Decimal         @default(0.00) @map("order_discount_amount") @db.Decimal(12, 2)
  subtotal             Decimal         @default(0.00) @db.Decimal(12, 2)
  totalDiscount        Decimal         @default(0.00) @map("total_discount") @db.Decimal(12, 2)
  totalAmount          Decimal         @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  totalCost            Decimal         @default(0.00) @map("total_cost") @db.Decimal(12, 2)
  totalMargin          Decimal         @default(0.00) @map("total_margin") @db.Decimal(12, 2)
  totalMarginPercent   Decimal         @default(0.00) @map("total_margin_percent") @db.Decimal(5, 2)
  oneTimeTotal         Decimal         @default(0.00) @map("one_time_total") @db.Decimal(12, 2)
  recurringMonthlyTotal Decimal        @default(0.00) @map("recurring_monthly_total") @db.Decimal(12, 2)
  recurringAnnualTotal  Decimal        @default(0.00) @map("recurring_annual_total") @db.Decimal(12, 2)
  notes                String?
  validUntil           DateTime?       @map("valid_until")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  tier         CustomerTier    @relation(fields: [organizationId, tierId], references: [organizationId, id], onDelete: Restrict)
  rep          User?           @relation(fields: [repId], references: [id], onDelete: SetNull)
  lines        QuotationLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, status])
  @@map("quotations")
}

model QuotationLine {
  id                   String           @id @default(uuid())
  organizationId       String           @map("organization_id")
  quotationId          String           @map("quotation_id")
  productId            String           @map("product_id")
  categoryId           String?          @map("category_id")
  quantity             Int              @default(1)
  unitPrice            Decimal          @map("unit_price") @db.Decimal(12, 2)
  costPrice            Decimal          @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  lineDiscountPercent  Decimal          @default(0.00) @map("line_discount_percent") @db.Decimal(5, 2)
  lineDiscountAmount   Decimal          @default(0.00) @map("line_discount_amount") @db.Decimal(12, 2)
  subtotal             Decimal          @default(0.00) @db.Decimal(12, 2)
  total                Decimal          @default(0.00) @db.Decimal(12, 2)
  marginAmount         Decimal          @default(0.00) @map("margin_amount") @db.Decimal(12, 2)
  marginPercent        Decimal          @default(0.00) @map("margin_percent") @db.Decimal(5, 2)
  billingFrequency     String           @default("one_time") @map("billing_frequency") // "one_time" | "monthly" | "quarterly" | "annual"
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation    Quotation        @relation(fields: [organizationId, quotationId], references: [organizationId, id], onDelete: Cascade)
  product      Product          @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  category     ProductCategory? @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, quotationId])
  @@index([organizationId, productId])
  @@map("quotation_lines")
}

